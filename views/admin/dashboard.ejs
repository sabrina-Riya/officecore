<%
  if (typeof filter === "undefined") filter = "all";
  if (typeof leaves === "undefined") leaves = [];
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin Dashboard</title>
  <style>
    body { font-family: Arial; background:#f4f6f8; padding:20px; }
    h2 { color:#333; }
    .cards { display:flex; flex-wrap: wrap; margin-bottom:20px; }
    .card {
      display:inline-block;
      padding:20px;
      margin:10px;
      background:#fff;
      box-shadow:0 2px 6px rgba(0,0,0,0.1);
      border-radius:8px;
      width:200px;
      text-align:center;
      text-decoration:none;
      color:#333;
      transition: transform 0.2s;
    }
    .card:hover { transform: scale(1.05); }

    .filter { margin:20px 0; }
    .filter select { padding:6px 10px; border-radius:4px; border:1px solid #ccc; font-size:14px; }
    .filter button { padding:6px 12px; border:none; border-radius:4px; background:#007bff; color:#fff; cursor:pointer; font-weight:bold; margin-left:5px; transition:0.2s; }
    .filter button:hover { background:#0056b3; }

    table { width:100%; border-collapse: collapse; background:#fff; box-shadow:0 2px 6px rgba(0,0,0,0.1); border-radius:5px; overflow:hidden; }
    th, td { padding:12px 15px; text-align:center; border-bottom:1px solid #ddd; }
    th { background:#007bff; color:#fff; font-weight:bold; }
    tr:last-child td { border-bottom:none; }

    a { text-decoration:none; color:#007bff; font-weight:bold; }
    a:hover { text-decoration:underline; }
    .action-links a { margin:0 5px; }
    .back-btn { display:inline-block; margin-bottom:15px; padding:6px 12px; background:#ccc; border-radius:4px; text-decoration:none; color:#333; }
    .back-btn:hover { background:#bbb; }

    .top-links { text-align:right; margin-bottom:20px; }
    .top-links a { margin-right:15px; font-weight:bold; color:#007bff; }
    .top-links form button { padding:6px 12px; border:none; border-radius:4px; background:#dc3545; color:#fff; font-weight:bold; cursor:pointer; transition:0.2s; }
  </style>
</head>
<body>

  <h2>Welcome, <%= adminName || "Admin" %></h2>

  <div class="top-links">
    <form action="/logout" method="POST" style="display:inline;">
      <button type="submit">Logout</button>
    </form>
  </div>

  <!-- Stats cards -->
  <div class="cards">
    <a href="/admin/users" class="card">
      <h3>Total Users</h3>
      <p><%= totalUsers || 0 %></p>
    </a>

    <a href="/admin/leave?status=pending" class="card">
      <h3>Pending Leaves</h3>
      <p><%= pendingLeave || 0 %></p>
    </a>

    <a href="/admin/leave?status=approved" class="card">
      <h3>Approved Leaves</h3>
      <p><%= approvedLeave || 0 %></p>
    </a>

    <a href="/admin/leave?status=rejected" class="card">
      <h3>Rejected Leaves</h3>
      <p><%= rejectedLeave || 0 %></p>
    </a>

    <a href="/admin/audit_logs" class="card">
      <h3>Audit Logs</h3>
    </a>
  </div>

  <!-- Filter form -->
  <form method="GET" action="/admin/leave" class="filter">
    <label for="status">Filter by status:</label>
    <select name="status" id="status">
      <option value="all" <%= filter === "all" ? "selected" : "" %>>All</option>
      <option value="pending" <%= filter === "pending" ? "selected" : "" %>>Pending</option>
      <option value="approved" <%= filter === "approved" ? "selected" : "" %>>Approved</option>
      <option value="rejected" <%= filter === "rejected" ? "selected" : "" %>>Rejected</option>
    </select>
    <button type="submit">Filter</button>
  </form>

  <!-- Leave table -->
  <% if (leaves.length > 0) { %>
    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Employee</th>
          <th>Start Date</th>
          <th>End Date</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% leaves.forEach(leave => { %>
          <tr>
            <td><%= leave.id %></td>
            <td><%= leave.employee_name || "-" %></td>
            <td><%= leave.start_date ? new Date(leave.start_date).toISOString().slice(0,10) : "-" %></td>
            <td><%= leave.end_date ? new Date(leave.end_date).toISOString().slice(0,10) : "-" %></td>
            <td><%= leave.status %></td>
            <td class="action-links">
              <a href="/admin/leave/<%= leave.id %>">View</a>
              <% if (leave.status === "pending") { %>
                <a href="/admin/leave/approve/<%= leave.id %>" onclick="return confirm('Approve this leave?')">Approve</a>
                <a href="/admin/leave/reject/<%= leave.id %>" onclick="return promptReject(<%= leave.id %>)">Reject</a>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>

  <script>
    function promptReject(id) {
      const reason = prompt("Please provide reason for rejection:");
      if (!reason || reason.trim() === "") {
        alert("Rejection reason is required!");
        return false;
      }
      window.location.href = `/admin/leave/reject/${id}?reason=${encodeURIComponent(reason)}`;
      return false;
    }
  </script>

</body>
</html>
