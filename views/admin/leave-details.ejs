<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Leave Details</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f0f2f5;
      padding: 30px;
      color: #333;
    }

    h2 {
      color: #222;
      margin-bottom: 20px;
    }

    .flash-success, .flash-error {
      padding: 10px 15px;
      border-radius: 5px;
      margin-bottom: 15px;
      font-weight: bold;
    }

    .flash-success {
      background: #d4edda;
      color: #155724;
      border: 1px solid #c3e6cb;
    }

    .flash-error {
      background: #f8d7da;
      color: #721c24;
      border: 1px solid #f5c6cb;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 20px;
      background: #fff;
      box-shadow: 0 2px 6px rgba(0,0,0,0.1);
      border-radius: 5px;
      overflow: hidden;
    }

    th, td {
      padding: 12px 15px;
      text-align: left;
      border-bottom: 1px solid #ddd;
    }

    th {
      background: #007bff;
      color: #fff;
      font-weight: bold;
    }

    tr:last-child td {
      border-bottom: none;
    }

    a {
      text-decoration: none;
      color: #007bff;
      font-weight: bold;
    }

    a:hover {
      text-decoration: underline;
    }

    .back-link {
      display: inline-block;
      margin-top: 20px;
      padding: 8px 15px;
      background: #007bff;
      color: #fff;
      border-radius: 5px;
      transition: background 0.2s;
    }

    .back-link:hover {
      background: #0056b3;
    }
  </style>
</head>
<body>

  <h2>Leave Details - <%= leave.employee_name %></h2>

  <% if (success_msg && success_msg.length > 0) { %>
    <div class="flash-success"><%= success_msg[0] %></div>
  <% } %>

  <% if (err_msg && err_msg.length > 0) { %>
    <div class="flash-error"><%= err_msg[0] %></div>
  <% } %>

  <table>
    <tr><th>ID</th><td><%= leave.id %></td></tr>
    <tr><th>Employee</th><td><%= leave.employee_name %></td></tr>
    <tr><th>Start Date</th><td><%= leave.start_date ? new Date(leave.start_date).toISOString().slice(0,10) : "-" %></td></tr>
    <tr><th>End Date</th><td><%= leave.end_date ? new Date(leave.end_date).toISOString().slice(0,10) : "-" %></td></tr>
    <tr><th>Status</th><td><%= leave.status %></td></tr>
    <tr><th>Created At</th><td><%= leave.created_at ? new Date(leave.created_at).toISOString().slice(0,10) : "-" %></td></tr>
  </table>

  <a class="back-link" href="/admin/leave">← Back to Leave Requests</a>

</body>
</html>
